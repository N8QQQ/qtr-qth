# Heritage Grade Documentation Staging (Stable)
FROM ruby:3.2-slim

RUN apt-get update && apt-get install -y build-essential git && rm -rf /var/lib/apt/lists/*

WORKDIR /srv/jekyll

# Install dependencies into the root of the workspace
COPY Gemfile* .
RUN bundle install

# Create a sub-directory for content to avoid volume masking
RUN mkdir -p /srv/jekyll/content
COPY docs/ /srv/jekyll/content/

EXPOSE 4000

# Run Jekyll pointing to the 'content' sub-directory
CMD ["bundle", "exec", "jekyll", "serve", "--host", "0.0.0.0", "--incremental", "--force_polling", "--source", "content", "--destination", "_site"]
