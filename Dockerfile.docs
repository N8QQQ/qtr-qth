# Heritage Grade Documentation Staging
# High-fidelity mirror of GitHub Pages (Jekyll + p5.js)

FROM jekyll/jekyll:4.2.2

# 1. Set Workspace
WORKDIR /srv/jekyll

# 2. Copy Gemfile and install dependencies first (caching)
COPY ./docs/Gemfile .
RUN bundle install

# 3. Copy Documentation Source
COPY ./docs .

# 4. Expose Jekyll Default Port
EXPOSE 4000

# 5. Run Jekyll Server with Live Reload
CMD ["bundle", "exec", "jekyll", "serve", "--host", "0.0.0.0", "--incremental", "--force_polling"]
