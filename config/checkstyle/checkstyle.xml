<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
          "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
          "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <!-- [BULLETPROOF ADD] Banning Imperative Loops Entirely via Global Regex -->
    <module name="RegexpSingleline">
        <property name="format" value="\s(for|while|do)\s*\("/>
        <property name="message" value="Imperative loops are forbidden. Use Streams API or Recursion."/>
    </module>

    <module name="TreeWalker">
        <module name="FinalLocalVariable"/>
        <module name="FinalParameters"/>
        <module name="VisibilityModifier"/>
        <module name="IllegalInstantiation">
            <property name="classes" value="java.util.ArrayList,java.util.HashMap,java.util.HashSet,java.util.LinkedHashMap,java.util.LinkedHashSet"/>
        </module>
        <module name="NestedIfDepth">
            <property name="max" value="1"/>
        </module>
        <module name="NestedTryDepth">
            <property name="max" value="0"/>
        </module>
        <module name="UnusedImports"/>
        <module name="PackageDeclaration"/>
        <module name="HideUtilityClassConstructor"/>
        <module name="OneStatementPerLine"/>
    </module>
</module>
