<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- Directory for log files -->
    <property name="LOG_DIR" value="logs" />

    <!-- CONSOLE: Standard output for the operator -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>[%X{pulseId:-System}] %msg%n</pattern>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
    </appender>

    <!-- SHACK_LOG: Daily rolling file for general operations -->
    <appender name="SHACK_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/qtr-qth.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/qtr-qth.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- TRACE_LOG: Granular telemetry log -->
    <appender name="TRACE_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/trace.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/trace.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{pulseId:-System}] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ASYNC WRAPPERS: Ensuring zero latency on the telemetry thread -->
    <appender name="ASYNC_SHACK" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="SHACK_FILE" />
        <discardingThreshold>0</discardingThreshold>
        <queueSize>512</queueSize>
    </appender>

    <appender name="ASYNC_TRACE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="TRACE_FILE" />
        <discardingThreshold>0</discardingThreshold>
        <queueSize>1024</queueSize>
    </appender>

    <!-- ROOT LOGGER -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="ASYNC_SHACK" />
    </root>

    <!-- Package-specific logging -->
    <logger name="com.stoicprogrammer.qtrqth" level="TRACE">
        <appender-ref ref="ASYNC_TRACE" />
    </logger>

</configuration>
