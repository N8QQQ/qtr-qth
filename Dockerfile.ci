# Heritage Grade Local CI Runner
# Mirrors the GitHub Actions Environment (Ubuntu 24.04 + JDK 21)

FROM ubuntu:24.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# 1. Install Core Dependencies
RUN apt-get update && apt-get install -y \
    curl \
    unzip \
    git \
    openjdk-21-jdk-headless \
    && rm -rf /var/lib/apt/lists/*

# 2. Set Environment Variables
ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# 3. Create Workspace
WORKDIR /workspace

# 4. Copy Project (using .dockerignore to exclude builds)
COPY . .

# 5. Pre-fetch Dependencies and Validate Wrapper
RUN chmod +x gradlew && ./gradlew --version

# Default command: Execute the full Quality Gate
CMD ["./gradlew", "clean", "checkstyleMain", "checkstyleTest", "test", "distZip", "--no-daemon"]
